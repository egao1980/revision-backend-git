(in-package #:revision-backend-git/tests)

;;; Graph queries and walks against rev-list / merge-base; as-of on both axes.

(defun git-children (repo)
  "Real git: hash table id → list of child ids over --branches --tags HEAD."
  (let ((table (make-hash-table :test #'equal)))
    (dolist (line (git-lines repo "rev-list" "--children" "--branches" "--tags" "HEAD"))
      (destructuring-bind (id &rest children)
          (remove "" (uiop:split-string line :separator '(#\Space)) :test #'string=)
        (setf (gethash id table) children)))
    table))

(deftest parents-children-heads
  (with-test-repo (r)
    (let ((k (build-merge r)))
      (with-store (s r)
        (ok (equal (list (getf k :m1) (getf k :f2)) (ids (rev:revision-parents s (getf k :x)))))
        (ok (null (rev:revision-parents s (getf k :base))))
        (let ((children (git-children r)))
          (dolist (name '(:base :f1 :f2 :m1 :x))
            (ok (set= (gethash (getf k name) children)
                      (ids (rev:revision-children s (getf k name))))
                (format nil "children of ~(~a~)" name))))
        (ok (set= (list (getf k :x)) (ids (rev:heads s))))))
    (with-test-repo (r)
      (let ((k (build-criss-cross r)))
        (with-store (s r)
          (ok (set= (list (getf k :d) (getf k :e) (getf k :u)) (ids (rev:heads s)))
              "heads of every branch, unrelated lines included"))))))

(deftest-parametrize walk-orders-match-rev-list
    ((from args walk-keys) :ids ("topo" "time" "first-parent" "topo-reverse" "time-reverse"
                                  "until" "several-from")
     ("main" '("--topo-order" "--reverse" "main") '(:order :topo))
     ("main" '("--date-order" "--reverse" "main") '(:order :time))
     ("main" '("--first-parent" "--reverse" "main") '(:order :first-parent))
     ("main" '("--topo-order" "main") '(:order :topo :reverse t))
     ("main" '("--date-order" "main") '(:order :time :reverse t))
     ("main" '("--topo-order" "--reverse" "main" "^feature~1") (list :order :topo :until "feature~1"))
     ((list "feature" "main~1") '("--topo-order" "--reverse" "feature" "main~1") '(:order :topo)))
  (with-test-repo (r)
    (build-merge r)
    (with-store (s r)
      (ok (equal (apply #'git-lines r "rev-list" args)
                 (ids (apply #'rev:walk-revisions s
                             (if (listp from) from (rev:rev-ref from))
                             walk-keys)))))))

(deftest walk-footprint-uses-first-parent-deltas
  (with-test-repo (r)
    (let ((k (build-merge r)))
      (with-store (s r)
        (let ((kept (ids (rev:walk-revisions s (rev:rev-ref "main") :footprint '("tree:/feature.txt")))))
          (ok (equal (list (getf k :f1) (getf k :f2) (getf k :x)) kept)
              "the merge's delta against its first parent adds feature.txt")
          (ok (not (equal kept (reverse (git-lines r "rev-list" "main" "--" "feature.txt"))))
              "not git's pathspec simplification (which drops the merge)"))
        (ok (equal (list (getf k :m1))
                   (ids (rev:walk-revisions s (rev:rev-ref "main") :footprint '("tree:/main.txt")))))
        (ok (null (rev:walk-revisions s (rev:rev-ref "main") :footprint '("tree:/nothing"))))))))

(deftest merge-base-and-ancestor-p
  (with-test-repo (r)
    (let ((k (build-merge r)))
      (with-store (s r)
        (ok (equal (getf k :base) (rev:revision-id (rev:merge-base s (getf k :m1) (getf k :f2)))))
        (ok (equal (getf k :base) (rev:revision-id (rev:merge-base s (getf k :base) (rev:rev-ref "main"))))
            "an ancestor is its own merge-base")
        (ok (rev:ancestor-p s (getf k :base) (getf k :x)))
        (ok (rev:ancestor-p s (getf k :f1) (getf k :x)))
        (ok (rev:ancestor-p s (getf k :x) (getf k :x)) "reflexive")
        (ok (not (rev:ancestor-p s (getf k :x) (getf k :base))))
        (ok (not (rev:ancestor-p s (getf k :m1) (getf k :f2)))))))
  (with-test-repo (r)
    (let ((k (build-criss-cross r)))
      (with-store (s r)
        (ok (set= (git-lines r "merge-base" "--all" (getf k :d) (getf k :e))
                  (ids (rev:merge-base s (getf k :d) (getf k :e) :all t))))
        (ok (= 2 (length (rev:merge-base s (getf k :d) (getf k :e) :all t))))
        (ok (equal (git r "merge-base" (getf k :d) (getf k :e))
                   (rev:revision-id (rev:merge-base s (getf k :d) (getf k :e))))
            "ALL NIL: git's single answer")
        (ok (null (rev:merge-base s (getf k :d) (getf k :u))) "unrelated → NIL")
        (ok (null (rev:merge-base s (getf k :d) (getf k :u) :all t)))
        (ok (not (rev:ancestor-p s (getf k :u) (getf k :d))))))))

(deftest revision-range-matches-rev-list
  (with-test-repo (r)
    (let ((k (build-merge r)))
      (with-store (s r)
        (ok (equal (git-lines r "rev-list" "--topo-order" "--reverse" (getf k :x) (format nil "^~a" (getf k :m1)))
                   (ids (rev:revision-range s (getf k :x) (getf k :m1)))))
        (ok (equal (list (getf k :f1) (getf k :f2) (getf k :x))
                   (ids (rev:revision-range s (rev:rev-ref "main") (getf k :m1)))))
        (ok (equal (git-lines r "rev-list" "--topo-order" "--reverse" "main")
                   (ids (rev:revision-range s (rev:rev-ref "main") nil)))
            "EXCLUDE NIL")
        (ok (equal (git-lines r "rev-list" "--topo-order" "--reverse" "feature" "main~1" "^main~1~1")
                   (ids (rev:revision-range s (list (rev:rev-ref "feature") "main~1") (list "main~2")))))
        (ok (null (rev:revision-range s (getf k :base) (getf k :x))))))))

(defun git-as-of-recorded (repo seconds on)
  (let ((out (git repo "rev-list" "-1" "--first-parent" (format nil "--before=@~d" seconds) on)))
    (if (string= out "") nil out)))

(deftest-parametrize as-of-recorded
    ((offset expected) :ids ("before-root" "at-root" "between" "at-c2" "after-tip")
     (-1 nil) (0 :c1) (99 :c1) (100 :c2) (250 :c3))
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((d (rev:rev-as-of (instant (+ +t0+ offset)) :on "main" :axis :recorded)))
          (ok (equal (git-as-of-recorded r (+ +t0+ offset) "main") (getf k expected))
              "fixture agrees with git rev-list --before")
          (if expected
              (ok (equal (getf k expected) (rev:revision-id (rev:resolve-revision s d))))
              (ok (signals (rev:resolve-revision s d) 'rev:revision-not-found))))))))

(deftest-parametrize as-of-valid
    ((offset expected) :ids ("tip" "backdated" "backdated-exact" "nothing-valid")
     (150 :c3) (149 :c2) (-10000 :c2) (-10001 nil))
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((d (rev:rev-as-of (instant (+ +t0+ offset)) :on "main" :axis :valid)))
          (if expected
              (ok (equal (getf k expected) (rev:revision-id (rev:resolve-revision s d))))
              (ok (signals (rev:resolve-revision s d) 'rev:revision-not-found))))))))

(deftest as-of-skips-side-branches
  (with-test-repo (r)
    (let ((k (build-merge r)))
      (with-store (s r)
        (ok (signals (rev:resolve-revision s (rev:rev-as-of (instant (- +t0+ 1)) :on "main" :axis :valid))
                     'rev:revision-not-found)
            "f1's old author date is not on main's first-parent line")
        (ok (equal (getf k :m1)
                   (rev:revision-id (rev:resolve-revision
                                     s (rev:rev-as-of (instant (+ +t0+ 350)) :on "main" :axis :recorded)))))
        (ok (equal (getf k :f1)
                   (rev:revision-id (rev:resolve-revision
                                     s (rev:rev-as-of (instant (+ +t0+ 150)) :on (rev:rev-ref "feature")
                                                                             :axis :recorded)))))))))
