(in-package #:revision-backend-git/tests)

;;; GIT-WORKING-COPY: stamp, state, drift, capture; HEAD and stamp-ref modes.
;;; Every capture must leave the worktree files and the real index file
;;; byte-identical.

(defun status-z (repo)
  (git* repo '("status" "--porcelain=v2" "-z" "--untracked-files=all" "--ignored")))

(defun worktree-snapshot (repo)
  "Bytes of every file under the worktree outside .git, sorted by path."
  (let ((root (trepo-dir repo)) (out '()))
    (labels ((walk (dir)
               (dolist (f (uiop:directory-files dir))
                 (push (cons (enough-namestring f root) (read-octets f)) out))
               (dolist (d (uiop:subdirectories dir))
                 (unless (equal ".git" (car (last (pathname-directory d))))
                   (walk d)))))
      (walk root))
    (sort out #'string< :key #'car)))

(deftest working-copy-values
  (with-test-repo (r)
    (build-working-copy r)
    (with-store (s r)
      (let ((wc (git:make-git-working-copy s)))
        (ok (git:git-working-copy-p wc))
        (ok (typep wc 'rev:revision-target))
        (ok (eq s (git:working-copy-store wc)))
        (ok (null (git:working-copy-stamp-ref wc)))
        (ok (probe-file (merge-pathnames "tracked.txt" (git:working-copy-path wc))))
        (ok (null (rev:target-fidelities wc)) "no projections in V0")
        (ok (not (rev:target-transactional-p wc))))
      (ok (signals (git:make-git-working-copy s :stamp-ref "not a ref") 'rev:revision-error))
      (ok (signals (git:make-git-working-copy s :stamp-ref "main") 'rev:revision-error)
          "a full ref name is required"))
    (with-test-repo (b :bare t)
      (with-store (s b)
        (ok (signals (git:make-git-working-copy s) 'rev:revision-error) "a bare repository has no worktree")))))

(deftest head-stamp
  (with-test-repo (r)
    (let ((c1 (getf (build-working-copy r) :c1)))
      (with-store (s r)
        (let ((wc (git:make-git-working-copy s)))
          (ok (equal (list c1) (rev:target-revisions wc)) "stamp = HEAD")
          (ok (signals (rev:target-stamp wc (list c1 c1 "HEAD")) 'rev:revision-error)
              "more than one revision")
          (ok (signals (rev:target-stamp wc nil) 'rev:revision-error) "HEAD cannot be cleared"))))
    (with-test-repo (r)
      (with-store (s r)
        (ok (null (rev:target-revisions (git:make-git-working-copy s))) "unborn HEAD")))))

(deftest target-state-is-what-add-all-would-record
  (with-test-repo (r)
    (build-working-copy r)
    (dirty-working-copy r)
    (with-store (s r)
      (let* ((wc (git:make-git-working-copy s))
             (before (index-digest r))
             (state (rev:target-state wc))
             (files (mapcar #'car (tree-files state))))
        (ok (equal '(".gitignore" "new.txt" "staged.txt" "tracked.txt") files)
            "untracked included, ignored and deleted files left out")
        (ok (equal (lines "t" "changed") (diff:tree-file-content (file-at state "tracked.txt")))
            "unstaged edits count")
        (ok (equalp before (index-digest r)) "real index untouched")
        (git* r '("add" "-A"))
        (ok (equal (git r "write-tree")
                   (rev:revision-content (rev:commit-revision s state :message "check")))
            "same tree as git add -A")))))

(deftest drift-against-head
  (with-test-repo (r)
    (let ((c1 (getf (build-working-copy r) :c1)))
      (with-store (s r)
        (let ((wc (git:make-git-working-copy s)))
          (ok (null (rev:target-drift wc s)) "clean")
          (put-file r "debug.log" (lines "ignored"))
          (ok (null (rev:target-drift wc s)) "ignored files are not drift")
          (put-file r "staged.txt" (lines "s" "x"))
          (git* r '("add" "staged.txt"))
          (put-file r "staged.txt" (lines "s"))
          (ok (null (rev:target-drift wc s)) "the index does not count, only the files")
          (dirty-working-copy r)
          (let ((d (rev:target-drift wc s)))
            (ok (typep d 'diff:diff))
            (when d
              (ok (set= '(("gone.txt") ("new.txt") ("staged.txt") ("tracked.txt"))
                        (remove-duplicates
                         (mapcar (lambda (c) (subseq (diff:change-path c) 0 1)) (diff:diff-changes d))
                         :test #'equal)))
              (ok (state= (rev:target-state wc)
                          (diff:apply-diff (rev:revision-state s c1) d))
                  "drift applied to the stamp's state = the working copy"))))))))

(deftest state-diff-with-the-working-copy
  (with-test-repo (r)
    (let ((c1 (getf (build-working-copy r) :c1)))
      (dirty-working-copy r)
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (d (rev:state-diff s c1 wc :level :summary)))
          (ok (set= '((:modify ("tracked.txt")) (:modify ("staged.txt")) (:remove ("gone.txt"))
                      (:add ("new.txt")))
                    (mapcar (lambda (c) (list (diff:change-kind c) (diff:change-path c)))
                            (diff:diff-changes d))))
          (ok (state= (rev:revision-state s c1)
                      (diff:apply-diff (rev:target-state wc) (rev:state-diff s wc c1)))
              "working copy → revision"))))))

(deftest capture-with-the-head-stamp
  (with-test-repo (r)
    (let ((c1 (getf (build-working-copy r) :c1)))
      (dirty-working-copy r)
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (files (worktree-snapshot r))
               (index (index-digest r))
               (state (rev:target-state wc))
               (rv (dt:with-fixed-clock ((instant (+ +t0+ 500)))
                     (rev:capture-revision wc s :message "checkpoint"))))
          (ok (equal (list c1) (rev:revision-parent-ids rv)) "parents = the stamp")
          (ok (equal "checkpoint" (rev:revision-message rv)))
          (ok (state= state (rev:revision-state s rv)) "tree = TARGET-STATE")
          (ok (equal (list (rev:revision-id rv)) (rev:target-revisions wc)) "stamped")
          (ok (equal (rev:revision-id rv) (rev r "main")) "HEAD's branch moved (reset --soft)")
          (ok (null (rev:target-drift wc s)) "no drift afterwards")
          (ok (equalp files (worktree-snapshot r)) "worktree byte-identical")
          (ok (equalp index (index-digest r)) "index byte-identical"))))))

(deftest capture-with-a-stamp-ref
  (with-test-repo (r)
    (let ((c1 (getf (build-working-copy r) :c1)))
      (dirty-working-copy r)
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s :stamp-ref "refs/checkpoints/agent"))
               (status (status-z r))
               (files (worktree-snapshot r))
               (index (index-digest r)))
          (ok (equal "refs/checkpoints/agent" (git:working-copy-stamp-ref wc)))
          (ok (null (rev:target-revisions wc)) "absent stamp ref = unstamped")
          (ok (equal (list c1) (rev:target-stamp wc (list (rev:resolve-revision s "HEAD")))))
          (ok (equal c1 (ref-id r "refs/checkpoints/agent")))
          (let ((rv (rev:capture-revision wc s)))
            (ok (equal (list c1) (rev:revision-parent-ids rv)))
            (ok (equal "capture" (rev:revision-message rv)) "default message")
            (ok (equal (rev:revision-id rv) (ref-id r "refs/checkpoints/agent")) "stamp ref moved")
            (ok (equal c1 (rev r "HEAD")) "HEAD untouched")
            (ok (equal c1 (rev r "main")) "branch untouched")
            (ok (null (rev:target-drift wc s)))
            (ok (equal status (status-z r)) "git status unchanged")
            (ok (equalp files (worktree-snapshot r)) "worktree byte-identical")
            (ok (equalp index (index-digest r)) "index byte-identical")
            (testing "explicit parents"
              (let ((rv2 (rev:capture-revision wc s :parents nil :message "root capture")))
                (ok (null (rev:revision-parent-ids rv2)))))
            (testing "clearing the stamp deletes the ref"
              (ok (null (rev:target-stamp wc nil)))
              (ok (null (ref-id r "refs/checkpoints/agent")))
              (ok (null (rev:target-revisions wc))))))))))

(deftest capture-on-an-unborn-branch
  (with-test-repo (r)
    (put-file r "first.txt" (lines "first"))
    (with-store (s r)
      (let* ((wc (git:make-git-working-copy s))
             (rv (rev:capture-revision wc s :message "initial")))
        (ok (null (rev:revision-parent-ids rv)) "a root")
        (ok (equal (rev:revision-id rv) (rev r "main")) "the unborn branch is created")
        (ok (null (rev:target-drift wc s)))))))
