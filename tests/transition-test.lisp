(in-package #:revision-backend-git/tests)

;;; V1 plans on a GIT-WORKING-COPY: PLAN-TRANSITION, EXECUTE-PLAN (HEAD stamp
;;; and stamp ref), drift restarts, resume, (SETF TARGET-STATE),
;;; PROJECT-PLAN fidelities and staleness, laws 5 and 6.

(defun build-side (repo k)
  "Branch side from c2 with s1 (adds side.txt); main stays checked out.
→ K with :s1 added."
  (git* repo (list "checkout" "-q" "-b" "side" (getf k :c2)))
  (put-file repo "side.txt" (lines "side"))
  (let ((s1 (commit-all repo "s1" :at (+ +t0+ 1000))))
    (git* repo '("checkout" "-q" "main"))
    (append k (list :s1 s1))))

(defun head-reflog (repo)
  "Real git: commit ids of HEAD's reflog, newest first."
  (git-lines repo "reflog" "--format=%H" "HEAD"))

(defun step-shapes (plan)
  (mapcar (lambda (st) (list (rev:step-direction st) (rev:step-from st) (rev:step-to st)))
          (rev:plan-steps plan)))

(defun worktree-tree (repo)
  "Real git: the tree `git add -A` would record in REPO's worktree (temp index)."
  (let ((index (%temp-file (trepo-root repo) "idx")))
    (unwind-protect
         (let ((env (list (cons "GIT_INDEX_FILE" (uiop:native-namestring index)))))
           (git* repo '("add" "-A") :env env)
           (string-right-trim '(#\Newline) (git* repo '("write-tree") :env env)))
      (ignore-errors (delete-file index)))))

(deftest working-copy-fidelities
  (with-test-repo (r)
    (build-working-copy r)
    (with-store (s r)
      (ok (equal '(:exact :shadow) (rev:target-fidelities (git:make-git-working-copy s))))
      (ok (not (rev:target-transactional-p (git:make-git-working-copy s)))
          "still not transactional in V1"))))

(deftest plan-shapes
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (with-store (s r)
        (let ((wc (git:make-git-working-copy s)))
          (testing "down along first parents"
            (let ((plan (with-checkout-unchanged (r "plan-transition")
                          (rev:plan-transition s wc (getf k :c2)))))
              (ok (rev:transition-plan-p plan))
              (ok (eq s (rev:plan-store plan)))
              (ok (equal (list (getf k :c4)) (rev:plan-start plan)))
              (ok (equal (list (getf k :c2)) (rev:plan-goal plan)))
              (ok (equal (getf k :c2) (rev:plan-base plan)))
              (ok (equal (list (list :down (getf k :c4) (getf k :c3))
                               (list :down (getf k :c3) (getf k :c2)))
                         (step-shapes plan)))))
          (testing "down to the merge-base, then up"
            (let ((plan (rev:plan-transition s wc "side")))
              (ok (equal (list (getf k :s1)) (rev:plan-goal plan)))
              (ok (equal (getf k :c2) (rev:plan-base plan)))
              (ok (equal (list (list :down (getf k :c4) (getf k :c3))
                               (list :down (getf k :c3) (getf k :c2))
                               (list :up (getf k :c2) (getf k :s1)))
                         (step-shapes plan)))))
          (testing "already there: no steps"
            (ok (null (rev:plan-steps (rev:plan-transition s wc "main")))))
          (ok (signals (rev:plan-transition s wc "nope") 'rev:revision-not-found)))))))

(deftest plan-steps-are-summary-diffs-and-reversible
  (with-test-repo (r)
    (let ((k (build-chain r)))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc (getf k :c2)))
               (first-step (first (rev:plan-steps plan))))
          (ok (every #'rev:step-reversible-p (rev:plan-steps plan)) "git steps always invert")
          (ok (every (lambda (st) (eq :summary (diff:diff-level (rev:step-diff st))))
                     (rev:plan-steps plan)))
          (ok (equal (mapcar (lambda (c) (list (diff:change-kind c) (diff:change-path c)))
                             (diff:diff-changes (rev:state-diff s (getf k :c4) (getf k :c3)
                                                                :level :summary)))
                     (mapcar (lambda (c) (list (diff:change-kind c) (diff:change-path c)))
                             (diff:diff-changes (rev:step-diff first-step))))
              "step diff = state-diff from → to at :summary")
          (ok (set= '("tree:/log.txt" "tree:/step-2.txt" "tree:/step-4.txt")
                    (rev:step-footprint first-step)))
          (let ((text (rev:describe-plan plan nil)))
            (ok (= 2 (count #\Newline text)))
            (ok (eql 0 (search (format nil "down ~a -> ~a tree:/" (getf k :c4) (getf k :c3)) text)))))))))

(deftest plan-from-an-unborn-branch
  (with-test-repo (r)
    (let ((k (build-chain r)))
      (git* r '("checkout" "-q" "--orphan" "fresh"))
      (git* r '("rm" "-rfq" "."))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc (getf k :c2))))
          (ok (null (rev:plan-start plan)))
          (ok (null (rev:plan-base plan)) "the empty state")
          (ok (equal (list (list :up nil (getf k :c1)) (list :up (getf k :c1) (getf k :c2)))
                     (step-shapes plan)))
          (ok (equal (list (getf k :c2)) (rev:execute-plan wc plan)))
          (ok (equal (getf k :c2) (rev r "fresh")) "the unborn branch is created")
          (ok (equal (tree-of r (getf k :c2)) (worktree-tree r)))
          (ok (null (rev:target-drift wc s))))))))

(deftest execute-plan-with-the-head-stamp
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (put-file r "keep.log" (lines "ignored"))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc "side"))
               (reflog (head-reflog r)))
          (multiple-value-bind (revs skipped) (rev:execute-plan wc plan)
            (ok (equal (list (getf k :s1)) revs) "law 5: target-revisions = plan goal")
            (ok (null skipped)))
          (ok (equal (list (getf k :s1)) (rev:target-revisions wc)))
          (ok (equal (list (getf k :s1) (getf k :c2) (getf k :c3))
                     (subseq (head-reflog r) 0 3))
              "one stamp per step, each naming the revision reached")
          (ok (= (+ 3 (length reflog)) (length (head-reflog r))))
          (ok (equal "refs/heads/main" (git r "symbolic-ref" "HEAD")) "still on main")
          (ok (equal (getf k :s1) (rev r "main")) "the current branch moved (reset --keep)")
          (ok (equal (tree-of r (getf k :s1)) (worktree-tree r)) "files = the goal")
          (ok (equal (tree-of r (getf k :s1)) (git r "write-tree")) "index = the goal")
          (ok (equal (lines "ignored") (from-utf8 (read-octets (repo-file r "keep.log"))))
              "ignored files untouched")
          (ok (equal (git r "status" "--porcelain=v2" "-z" "--untracked-files=all") "")
              "clean afterwards")
          (ok (null (rev:target-drift wc s))))))))

(deftest execute-plan-with-a-stamp-ref
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s :stamp-ref "refs/checkpoints/agent"))
               (index (index-hash r)))
          (rev:target-stamp wc (list (getf k :c4)))
          (let ((plan (rev:plan-transition s wc "side")))
            (ok (equal (list (getf k :s1)) (rev:execute-plan wc plan)))
            (ok (equal (getf k :s1) (ref-id r "refs/checkpoints/agent")) "stamp ref moved")
            (ok (equal (getf k :c4) (rev r "HEAD")) "HEAD untouched")
            (ok (equal (getf k :c4) (rev r "main")) "branch untouched")
            (ok (equal index (index-hash r)) "real index untouched")
            (ok (equal (tree-of r (getf k :s1)) (worktree-tree r)) "files = the goal")
            (ok (null (rev:target-drift wc s)))))))))

(deftest execute-plan-drift-restarts
  (with-test-repo (r)
    (let ((k (build-chain r)))
      (with-store (s r)
        (let ((wc (git:make-git-working-copy s)))
          (put-file r "log.txt" (lines "dirty"))
          (let ((plan (rev:plan-transition s wc (getf k :c2))))
            (testing "TARGET-DRIFT-DETECTED and its restarts"
              (multiple-value-bind (names c)
                  (restart-names-in 'rev:target-drift-detected (lambda () (rev:execute-plan wc plan)))
                (ok (typep c 'rev:target-drift-detected))
                (when c
                  (ok (eq wc (rev:target-drift-detected-target c)))
                  (ok (typep (rev:target-drift-detected-drift c) 'diff:diff)))
                (dolist (n '(rev:capture-and-continue rev:discard-drift abort))
                  (ok (member n names) (format nil "restart ~a" n)))))
            (testing "abort: nothing changed"
              (ok (null (handler-bind ((rev:target-drift-detected
                                         (lambda (c) (invoke-restart (find-restart 'abort c)))))
                          (rev:execute-plan wc plan))))
              (ok (equal (getf k :c4) (rev r "HEAD")))
              (ok (equal (lines "dirty") (from-utf8 (read-octets (repo-file r "log.txt"))))))
            (testing "discard-drift: reset to the stamp, then run"
              (ok (equal (list (getf k :c2))
                         (handler-bind ((rev:target-drift-detected
                                          (lambda (c) (invoke-restart (find-restart 'rev:discard-drift c)))))
                           (rev:execute-plan wc plan))))
              (ok (equal (lines "at 2") (from-utf8 (read-octets (repo-file r "log.txt")))))
              (ok (null (rev:target-drift wc s))))))))))

(deftest execute-plan-capture-and-continue
  (with-test-repo (r)
    (let ((k (build-chain r)))
      (with-store (s r)
        (let ((wc (git:make-git-working-copy s)))
          (put-file r "notes.txt" (lines "unsaved work"))
          (let ((plan (rev:plan-transition s wc (getf k :c2))))
            (ok (equal (list (getf k :c2))
                       (handler-bind ((rev:target-drift-detected
                                        (lambda (c)
                                          (invoke-restart (find-restart 'rev:capture-and-continue c)
                                                          :message "saved"))))
                         (rev:execute-plan wc plan))))
            (let* ((saved (find-if (lambda (id) (equal "saved" (git r "log" "-1" "--format=%s" id)))
                                   (head-reflog r))))
              (ok saved "the drift was captured as a commit")
              (when saved
                (ok (equal (getf k :c4) (git r "log" "-1" "--format=%P" saved)) "child of the stamp")
                (ok (equal (lines "unsaved work") (blob-text r saved "notes.txt")))))
            (ok (equal (tree-of r (getf k :c2)) (worktree-tree r)) "goal reached")
            (ok (null (rev:target-drift wc s)))))))))

(deftest execute-plan-resumes
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc (getf k :c2))))
          (git* r (list "reset" "-q" "--hard" (getf k :c3)))   ; an earlier run stopped after step 1
          (let ((reflog (head-reflog r)))
            (ok (equal (list (getf k :c2)) (rev:execute-plan wc plan)))
            (ok (= (1+ (length reflog)) (length (head-reflog r))) "only the remaining step ran"))
          (testing "a stamp that is neither the start nor any step's TO"
            (git* r (list "reset" "-q" "--hard" (getf k :s1)))
            (ok (signals (rev:execute-plan wc plan) 'rev:revision-error))
            (ok (equal (getf k :s1) (rev r "HEAD")) "nothing changed")))))))

(deftest setf-target-state
  (with-test-repo (r)
    (let ((k (build-chain r)))
      (put-file r "keep.log" (lines "ignored"))
      (put-file r "stray.txt" (lines "stray"))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (state (rev:revision-state s (getf k :c1)))
               (index (index-hash r)))
          (setf (rev:target-state wc) state)
          (ok (state= state (rev:target-state wc)) "target-state = STATE")
          (ok (equal (tree-of r (getf k :c1)) (worktree-tree r)))
          (ok (not (probe-file (repo-file r "stray.txt"))) "untracked non-ignored file removed")
          (ok (not (probe-file (repo-file r "step-3.txt"))) "tracked file outside STATE removed")
          (ok (equal (lines "ignored") (from-utf8 (read-octets (repo-file r "keep.log")))))
          (ok (equal (getf k :c4) (rev r "HEAD")) "stamp untouched")
          (ok (equal index (index-hash r)) "real index untouched")
          (ok (rev:target-drift wc s) "the target drifts now")
          (ok (state= state (diff:apply-diff (rev:revision-state s (getf k :c4)) (rev:target-drift wc s)))))))))

(deftest project-plan-exact
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc "side"))
               (p (with-checkout-unchanged (r "project-plan :exact")
                    (rev:project-plan wc plan))))
          (ok (eq :exact (rev:projection-fidelity p)) "default = first of target-fidelities")
          (ok (null (git:git-projection-worktree p)) "virtual")
          (ok (equal (list (getf k :s1)) (rev:projection-parents p)) "parents = plan goal")
          (ok (equal (tree-of r (getf k :s1)) (git:git-projection-tree p)))
          (ok (diff:diff-empty-p (rev:state-diff s plan (getf k :s1))) "state-diff over a plan")
          (let ((projected (rev:projection-state p)))
            (rev:execute-plan wc plan)
            (ok (state= projected (rev:target-state wc)) "law 6: :exact equals execution")))))))

(deftest project-plan-shadow
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (put-file r "log.txt" (lines "drift"))
      (with-store (s r)
        (let* ((git:*projection-directory*
                 (ensure-directories-exist (merge-pathnames "projections/" (trepo-root r))))
               (wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc "side"))
               (p (with-checkout-unchanged (r "project-plan :shadow")
                    (rev:project-plan wc plan :fidelity :shadow)))
               (wt (git:git-projection-worktree p)))
          (ok (eq :shadow (rev:projection-fidelity p)))
          (ok (and wt (uiop:directory-exists-p wt)) "materialized")
          (ok (typep (pathlib:path-filesystem (rev:projection-view p)) 'pathlib:local-filesystem))
          (ok (equal (list (getf k :s1)) (rev:projection-parents p)))
          (ok (equal (lines "side") (from-utf8 (read-octets (merge-pathnames "side.txt" wt))))
              "the steps really ran there")
          (ok (equal (lines "at 2") (from-utf8 (read-octets (merge-pathnames "log.txt" wt))))
              "from the stamped revision: the target's drift is left behind")
          (ok (equal (getf k :c4) (rev r "HEAD")) "the target did not move")
          (rev:discard-projection p)
          (ok (not (uiop:directory-exists-p wt))))))))

(deftest project-plan-model-is-unsupported
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc "side")))
          (multiple-value-bind (names c)
              (restart-names-in 'rev:projection-unsupported
                                (lambda () (rev:project-plan wc plan :fidelity :model)))
            (ok (typep c 'rev:projection-unsupported))
            (when c
              (ok (eq :model (rev:projection-unsupported-fidelity c)))
              (ok (equal '(:exact :shadow) (rev:projection-unsupported-supported c))))
            (ok (member 'rev:use-shadow names))
            (ok (member 'rev:apply-for-real names))
            (ok (not (member 'rev:accept-model-fidelity names)) "only applicable restarts"))
          (let* ((git:*projection-directory*
                   (ensure-directories-exist (merge-pathnames "projections/" (trepo-root r))))
                 (p (handler-bind ((rev:projection-unsupported
                                     (lambda (c) (invoke-restart (find-restart 'rev:use-shadow c)))))
                      (rev:project-plan wc plan :fidelity :model))))
            (ok (eq :shadow (rev:projection-fidelity p)))
            (rev:discard-projection p))
          (let ((p (handler-bind ((rev:projection-unsupported
                                    (lambda (c) (invoke-restart (find-restart 'rev:apply-for-real c)))))
                     (rev:project-plan wc plan :fidelity :model))))
            (ok (eq :exact (rev:projection-fidelity p)))
            (ok (equal (list (getf k :s1)) (rev:target-revisions wc)) "apply-for-real executed the plan")))))))

(deftest target-projections-go-stale
  (with-test-repo (r)
    (let ((k (build-side r (build-chain r))))
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (plan (rev:plan-transition s wc "side"))
               (by-stamp (rev:project-plan wc plan))
               (by-file (rev:project-plan wc plan)))
          (ok (rev:projection-state by-stamp) "fresh: readable")
          (put-file r "log.txt" (lines "edited outside"))
          (ok (signals (rev:projection-state by-file) 'rev:projection-stale) "state changed")
          (ok (signals (rev:commit-projection s by-file) 'rev:projection-stale))
          (put-file r "log.txt" (lines "at 4"))
          (rev:target-stamp wc (list (getf k :c3)))
          (ok (signals (rev:projection-view by-stamp) 'rev:projection-stale) "stamp changed"))))))
