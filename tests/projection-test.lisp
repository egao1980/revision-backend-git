(in-package #:revision-backend-git/tests)

;;; V1 projections: PROJECT-STATE (virtual and materialized), the views,
;;; writable edits, APPLY-PATCH, COMMIT-PROJECTION, DISCARD-PROJECTION, and
;;; STATE-DIFF over projections. Every operation leaves the main checkout
;;; byte-identical (WITH-CHECKOUT-UNCHANGED).

(defmacro with-projection-dir ((var repo) &body body)
  "Bind *PROJECTION-DIRECTORY* to a fresh directory in REPO's temp root (outside
the worktree) → BODY's values."
  `(let* ((,var (ensure-directories-exist (merge-pathnames "projections/" (trepo-root ,repo))))
          (git:*projection-directory* ,var))
     ,@body))

(deftest project-state-values
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let ((p (with-checkout-unchanged (r "project-state")
                   (rev:project-state s (getf k :k2)))))
          (ok (git:git-projection-p p))
          (ok (typep p 'rev:projection))
          (ok (eq :exact (rev:projection-fidelity p)))
          (ok (equal (list (getf k :k2)) (rev:projection-parents p)))
          (ok (null (rev:projection-conflicts p)))
          (ok (not (rev:projection-writable-p p)))
          (ok (not (rev:projection-discarded-p p)))
          (ok (null (git:git-projection-worktree p)) "virtual: no worktree")
          (ok (null (git:merge-projection-marker-tree p)))
          (ok (equal (tree-of r (getf k :k2)) (git:git-projection-tree p)))
          (ok (state= (rev:revision-state s (getf k :k2)) (rev:projection-state p)))
          (ok (signals (setf (rev:projection-state p) (diff:make-tree)) 'rev:revision-error)
              "not writable")
          (testing "parents list is fresh"
            (setf (first (rev:projection-parents p)) "mallory")
            (ok (equal (list (getf k :k2)) (rev:projection-parents p)))))
        (ok (signals (rev:project-state s "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef")
                     'rev:revision-not-found))))))

(deftest-parametrize project-state-fidelity-is-always-exact
    ((fidelity) :ids ("nil" "exact" "shadow" "model")
     (nil) (:exact) (:shadow) (:model))
  ;; Git trees are exact; the protocol lets a backend return better than asked.
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((p (rev:project-state s (getf k :c2) :fidelity fidelity)))
          (ok (eq :exact (rev:projection-fidelity p)))
          (ok (state= (rev:revision-state s (getf k :c2)) (rev:projection-state p))))))))

(deftest project-state-view-is-a-read-only-tree
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let* ((p (rev:project-state s (getf k :k1)))
               (view (rev:projection-view p)))
          (ok (pathlib:path-p view))
          (ok (git:revision-filesystem-p (pathlib:path-filesystem view)))
          (ok (equal (tree-of r (getf k :k1))
                     (git:revision-filesystem-tree (pathlib:path-filesystem view))))
          (ok (equal +main-v1+ (pathlib:read-text (pathlib:join view "src/main.lisp"))))
          (ok (equalp +bin-v1+ (pathlib:read-bytes (pathlib:join view "bin/data.bin"))))
          (ok (signals (pathlib:write-text (pathlib:join view "new.txt") "x")
                       'pathlib:unsupported-operation))
          (testing "pinned: moving main later does not change the view"
            (rev:move-ref s "main" (getf k :k3))
            (ok (pathlib:file-p (pathlib:join view "thing")))))))))

(deftest tree-filesystem
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let* ((tree (tree-of r (getf k :k2)))
               (fs (git:make-tree-filesystem s tree)))
          (ok (git:revision-filesystem-p fs))
          (ok (null (git:revision-filesystem-revision fs)))
          (ok (equal tree (git:revision-filesystem-tree fs)))
          (pathlib:with-filesystem (fs)
            (ok (equal +main-v2+ (pathlib:read-text "/src/main.lisp")))
            (ok (= (encode-universal-time 0 0 0 1 1 1970 0)
                   (pathlib:last-modified "/README"))
                "epoch mtime")))
        (ok (equal (tree-of r (getf k :k1))
                   (git:revision-filesystem-tree (git:make-revision-filesystem s (getf k :k1))))
            "a commit's filesystem reports its tree")
        (ok (signals (git:make-tree-filesystem s (getf k :k1)) 'rev:revision-error)
            "a commit id is not a tree")))))

(deftest project-state-of-the-working-copy
  ;; A projection of the working copy's state, uncommitted changes included
  ;; (the area-over-a-working-copy case): parents = the stamp.
  (with-test-repo (r)
    (let ((c1 (getf (build-working-copy r) :c1)))
      (dirty-working-copy r)
      (with-store (s r)
        (let* ((wc (git:make-git-working-copy s))
               (state (rev:target-state wc))
               (p (with-checkout-unchanged (r "project-state of a working copy")
                    (rev:project-state s wc))))
          (ok (eq :exact (rev:projection-fidelity p)))
          (ok (equal (list c1) (rev:projection-parents p)))
          (ok (state= state (rev:projection-state p)))
          (ok (equal (lines "new") (pathlib:read-text (pathlib:join (rev:projection-view p) "new.txt")))
              "untracked file visible")
          (ok (not (pathlib:exists-p (pathlib:join (rev:projection-view p) "debug.log")))
              "ignored file left out"))))))

(deftest project-state-of-a-projection
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let* ((p1 (rev:project-state s (getf k :c1)))
               (p2 (rev:project-state s p1)))
          (ok (not (eq p1 p2)))
          (ok (equal (rev:projection-parents p1) (rev:projection-parents p2)))
          (ok (equal (git:git-projection-tree p1) (git:git-projection-tree p2))))))))

(deftest writable-projection-is-a-linked-worktree
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (with-projection-dir (dir r)
          (let* ((p (with-checkout-unchanged (r "writable project-state")
                      (rev:project-state s (getf k :k2) :writable t)))
                 (wt (git:git-projection-worktree p)))
            (ok (rev:projection-writable-p p))
            (ok (eq :exact (rev:projection-fidelity p)))
            (ok (equal (list (getf k :k2)) (rev:projection-parents p)))
            (ok (and wt (uiop:directory-exists-p wt)) "materialized")
            (ok (and wt (pathname-under-p wt dir)) "under *projection-directory*")
            (ok (and wt (not (pathname-under-p wt (trepo-dir r)))) "outside the main worktree")
            (ok (and wt (member (namestring (truename wt)) (worktree-paths r) :test #'string=))
                "a registered linked worktree")
            (ok (equal (git r "rev-parse" "HEAD") (getf k :k3)) "main checkout HEAD unchanged")
            (let ((view (rev:projection-view p)))
              (ok (pathlib:path-p view))
              (ok (typep (pathlib:path-filesystem view) 'pathlib:local-filesystem))
              (ok (equal +main-v2+ (pathlib:read-text (pathlib:join view "src/main.lisp")))))
            (ok (equal (tree-of r (getf k :k2)) (git:git-projection-tree p)) "state = k2 before edits")
            (rev:discard-projection p)))))))

(deftest writable-projection-sees-file-edits
  ;; Anything writing into the worktree (pathlib, CL:OPEN, a shell, an image)
  ;; changes PROJECTION-STATE: it is what `git add -A` would record there.
  (with-test-repo (r)
    (let ((k (build-working-copy r)))
      (with-store (s r)
        (with-projection-dir (dir r)
          (let* ((p (rev:project-state s (getf k :c1) :writable t))
                 (wt (git:git-projection-worktree p)))
            (with-checkout-unchanged (r "edits in a projection")
              (write-octets (merge-pathnames "tracked.txt" wt) (utf8 (lines "t" "edited")))
              (write-octets (merge-pathnames "added/new.txt" wt) (utf8 (lines "added")))
              (write-octets (merge-pathnames "noise.log" wt) (utf8 (lines "ignored")))
              (delete-file (merge-pathnames "gone.txt" wt))
              (pathlib:write-text (pathlib:join (rev:projection-view p) "via-pathlib.txt")
                                  (lines "pathlib"))
              (let ((files (mapcar #'car (tree-files (rev:projection-state p)))))
                (ok (equal '(".gitignore" "added/new.txt" "staged.txt" "tracked.txt" "via-pathlib.txt")
                           files)
                    "add -A semantics: untracked in, ignored and deleted out"))
              (ok (equal (lines "t" "edited")
                         (diff:tree-file-content (file-at (rev:projection-state p) "tracked.txt")))))
            (rev:discard-projection p)))))))

(deftest setf-projection-state
  (with-test-repo (r)
    (let ((k (build-working-copy r)))
      (with-store (s r)
        (with-projection-dir (dir r)
          (let* ((p (rev:project-state s (getf k :c1) :writable t))
                 (wt (git:git-projection-worktree p))
                 (state (diff:make-tree ".gitignore" (diff:make-tree-file (lines "*.log"))
                                        "only.txt" (diff:make-tree-file (lines "only"))
                                        "sub" (diff:make-tree "x.txt" (diff:make-tree-file (lines "x"))))))
            (write-octets (merge-pathnames "stray.txt" wt) (utf8 (lines "stray")))
            (write-octets (merge-pathnames "keep.log" wt) (utf8 (lines "ignored")))
            (with-checkout-unchanged (r "setf projection-state")
              (setf (rev:projection-state p) state))
            (ok (state= state (rev:projection-state p)) "state replaced exactly")
            (ok (equal (lines "only") (from-utf8 (read-octets (merge-pathnames "only.txt" wt)))))
            (ok (not (probe-file (merge-pathnames "tracked.txt" wt))) "tracked files outside STATE removed")
            (ok (not (probe-file (merge-pathnames "stray.txt" wt))) "untracked files outside STATE removed")
            (ok (probe-file (merge-pathnames "keep.log" wt)) "ignored files left alone")
            (rev:discard-projection p)))))))

(deftest commit-projection-from-a-writable-projection
  (with-test-repo (r)
    (let ((k (build-working-copy r)))
      (with-store (s r)
        (with-projection-dir (dir r)
          (let* ((p (rev:project-state s (getf k :c1) :writable t))
                 (wt (git:git-projection-worktree p)))
            (write-octets (merge-pathnames "tracked.txt" wt) (utf8 (lines "t" "agent")))
            (let ((rv (with-checkout-unchanged (r "commit-projection")
                        (dt:with-fixed-clock ((instant (+ +t0+ 900)))
                          (rev:commit-projection s p :message "agent edit" :ref "agent"
                                                     :valid-at (instant (+ +t0+ 800))
                                                     :provenance '(:author-name "Agent"))))))
              (ok (typep rv 'rev:revision))
              (ok (equal (list (getf k :c1)) (rev:revision-parent-ids rv)) "parents = projection-parents")
              (ok (equal "agent edit" (rev:revision-message rv)))
              (ok (equal (rev:revision-id rv) (rev r "agent")) "ref created")
              (ok (equal (getf k :c1) (rev r "main")) "main untouched")
              (ok (= (+ +t0+ 800) (unix (rev:revision-valid-at rv))))
              (ok (= (+ +t0+ 900) (unix (rev:revision-recorded-at rv))))
              (ok (equal "Agent" (getf (rev:revision-provenance rv) :author-name)))
              (ok (equal (lines "t" "agent") (blob-text r (rev:revision-id rv) "tracked.txt")))
              (ok (state= (rev:projection-state p) (rev:revision-state s rv)))
              (testing "explicit parents"
                (let ((root (rev:commit-projection s p :parents nil :message "root")))
                  (ok (null (rev:revision-parent-ids root))))))
            (rev:discard-projection p)))))))

(deftest commit-projection-refusals
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((p (rev:project-state s (getf k :c1)))
              (main (rev r "main")))
          (ok (signals (rev:commit-projection s p :id "chosen") 'rev:revision-error)
              ":id refused")
          (ok (equal main (rev r "main")))
          (ok (signals (rev:commit-projection s p :ref "v1") 'rev:tag-immutable)
              "a tag never moves")
          (ok (rev:commit-projection s p :message "on top" :ref "main")
              "virtual projections commit too (parents = the projected revision)")
          (ok (equal (list (getf k :c1))
                     (rev:revision-parent-ids (rev:resolve-revision s "main")))))))))

(deftest discard-projection
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (with-projection-dir (dir r)
          (let* ((virtual (rev:project-state s (getf k :c2)))
                 (materialized (rev:project-state s (getf k :c2) :writable t))
                 (wt (git:git-projection-worktree materialized)))
            (with-checkout-unchanged (r "discard-projection")
              (ok (eq t (rev:discard-projection virtual)))
              (ok (eq t (rev:discard-projection materialized))))
            (ok (eq t (rev:discard-projection materialized)) "idempotent")
            (ok (rev:projection-discarded-p virtual))
            (ok (rev:projection-discarded-p materialized))
            (ok (not (uiop:directory-exists-p wt)) "worktree directory deleted")
            (ok (= 1 (length (worktree-paths r))) "worktree unregistered")
            (ok (null (git:git-projection-worktree materialized)))
            (dolist (p (list virtual materialized))
              (ok (signals (rev:projection-state p) 'rev:revision-error))
              (ok (signals (rev:projection-view p) 'rev:revision-error))
              (ok (signals (git:git-projection-tree p) 'rev:revision-error))
              (ok (signals (rev:commit-projection s p) 'rev:revision-error)))
            (ok (signals (setf (rev:projection-state materialized) (diff:make-tree))
                         'rev:revision-error))))))))

(deftest apply-patch-text
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let* ((p1 (rev:project-state s (getf k :k1)))
               (patch (sample-patch r (getf k :k1) (getf k :k2)))
               (p2 (with-checkout-unchanged (r "apply-patch")
                     (git:apply-patch p1 patch))))
          (ok (git:git-projection-p p2))
          (ok (not (eq p1 p2)) "a new projection")
          (ok (eq :exact (rev:projection-fidelity p2)))
          (ok (not (rev:projection-writable-p p2)))
          (ok (null (git:git-projection-worktree p2)) "virtual")
          (ok (equal (rev:projection-parents p1) (rev:projection-parents p2)))
          (ok (equal (tree-of r (getf k :k2)) (git:git-projection-tree p2))
              "renames, modes, binary, symlinks: same tree as k2")
          (ok (equal (tree-of r (getf k :k1)) (git:git-projection-tree p1)) "source unchanged")
          (testing "a patch as a string (k2 → k3: file → directory)"
            (let ((p (git:apply-patch (rev:project-state s (getf k :k2))
                                      (from-utf8 (sample-patch r (getf k :k2) (getf k :k3))))))
              (ok (equal (tree-of r (getf k :k3)) (git:git-projection-tree p))))))))))

(deftest apply-patch-rejected
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let* ((p3 (rev:project-state s (getf k :k3)))
               (patch (sample-patch r (getf k :k1) (getf k :k2)))
               (objects (git r "count-objects"))
               (c (with-checkout-unchanged (r "rejected patch")
                    (capture-condition (git:patch-rejected) (git:apply-patch p3 patch)))))
          (ok (typep c 'git:patch-rejected) "k1→k2 does not apply to k3")
          (ok (typep c 'rev:revision-error))
          (when c
            (ok (eq p3 (git:patch-rejected-projection c)))
            (ok (stringp (git:patch-rejected-stderr c))))
          (ok (equal objects (git r "count-objects")) "no loose object written")
          (ok (equal (tree-of r (getf k :k3)) (git:git-projection-tree p3))))))))

(deftest apply-patch-diff-value
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let* ((p1 (rev:project-state s (getf k :k1)))
               (d (rev:state-diff s (getf k :k1) (getf k :k2)))
               (p2 (git:apply-patch p1 d)))
          (ok (equal (tree-of r (getf k :k2)) (git:git-projection-tree p2)))
          (testing "a diff that does not apply: diff-protocol's APPLY-CONFLICT"
            (let ((p3 (rev:project-state s (getf k :k3))))
              (ok (signals (git:apply-patch p3 (rev:state-diff s (getf k :k1) (getf k :k2)))
                           'diff:apply-conflict)))))
        (let ((p (rev:project-state s (getf k :k1))))
          (rev:discard-projection p)
          (ok (signals (git:apply-patch p "") 'rev:revision-error) "discarded source"))))))

(deftest state-diff-over-projections
  (with-test-repo (r)
    (let ((k (build-content r)))
      (with-store (s r)
        (let* ((p1 (rev:project-state s (getf k :k1)))
               (p2 (rev:project-state s (getf k :k2)))
               (d (rev:state-diff s p1 p2 :level :summary)))
          (ok (equal (mapcar (lambda (c) (list (diff:change-kind c) (diff:change-path c)))
                             (diff:diff-changes (rev:state-diff s (getf k :k1) (getf k :k2) :level :summary)))
                     (mapcar (lambda (c) (list (diff:change-kind c) (diff:change-path c)))
                             (diff:diff-changes d)))
              "same as between the revisions")
          (ok (diff:diff-empty-p (rev:state-diff s p2 (getf k :k2))) "projection vs its revision")
          (ok (state= (rev:projection-state p2)
                      (diff:apply-diff (rev:projection-state p1) (rev:state-diff s p1 p2)))
              "law 3 across projections"))))))

(deftest projections-on-a-bare-store
  (with-test-repo (src)
    (let ((k (build-linear src)))
      (with-test-repo (b :bare t)
        (git* b (list "fetch" "-q" (uiop:native-namestring (trepo-dir src)) "main:main"))
        (with-store (s b)
          (with-projection-dir (dir b)
            (let ((p (rev:project-state s (getf k :c3))))
              (ok (equal (tree-of b (getf k :c3)) (git:git-projection-tree p))))
            (let ((w (rev:project-state s (getf k :c3) :writable t)))
              (ok (uiop:directory-exists-p (git:git-projection-worktree w))
                  "a bare repository can still materialize a projection")
              (ok (state= (rev:revision-state s (getf k :c3)) (rev:projection-state w)))
              (rev:discard-projection w))))))))
