(in-package #:revision-backend-git/tests)

;;; V1 linked worktrees: ADD-WORKTREE, LIST-WORKTREES, REMOVE-WORKTREE, stores
;;; and working copies on a linked worktree, PARSE-WORKTREE-LIST.

(defun wt-dir (repo name)
  (merge-pathnames (format nil "~a/" name) (trepo-root repo)))

(defun same-dir-p (a b)
  (equal (namestring (truename a)) (namestring (truename b))))

(deftest add-worktree-detached
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let* ((dir (wt-dir r "wt1"))
               (w (with-checkout-unchanged (r "add-worktree")
                    (git:add-worktree s dir (getf k :c2)))))
          (unwind-protect
               (progn
                 (ok (git:git-store-p w))
                 (ok (not (eq s w)) "a new store")
                 (ok (same-dir-p dir (git:git-store-path w)))
                 (ok (not (git:git-store-bare-p w)))
                 (ok (same-dir-p (git:git-store-common-dir s) (git:git-store-common-dir w))
                     "same repository")
                 (ok (same-dir-p (git:git-store-git-dir s) (git:git-store-common-dir s))
                     "main store: git dir = common dir")
                 (ok (not (same-dir-p (git:git-store-git-dir w) (git:git-store-common-dir w)))
                     "linked: <common>/worktrees/<name>/")
                 (ok (equal (getf k :c2) (rev:revision-id (rev:resolve-revision w "HEAD")))
                     "detached at c2")
                 (ok (equal "" (git* r (list "-C" (uiop:native-namestring dir) "symbolic-ref" "-q" "HEAD")
                                     :ok '(1) :directory nil))
                     "HEAD detached")
                 (ok (equal (getf k :c3) (rev:revision-id (rev:resolve-revision w "main")))
                     "refs are shared")
                 (ok (equal (git:git-store-env s) (git:git-store-env w)) "same :env")
                 (ok (equal (lines "one" "two") (from-utf8 (read-octets (merge-pathnames "a.txt" dir))))))
            (git:close-git-store w)))))))

(deftest add-worktree-with-a-branch
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((w (git:add-worktree s (wt-dir r "wt2") (getf k :c1) :branch "work")))
          (ok (equal (getf k :c1) (rev r "work")) "branch created at c1")
          (ok (equal "refs/heads/work"
                     (string-right-trim '(#\Newline)
                                        (git* r (list "-C" (uiop:native-namestring (wt-dir r "wt2"))
                                                      "symbolic-ref" "HEAD")
                                              :directory nil)))
              "checked out there")
          (git:close-git-store w))
        (let ((c (capture-condition (rev:ref-conflict)
                   (git:add-worktree s (wt-dir r "wt3") (getf k :c2) :branch "work"))))
          (ok (typep c 'rev:ref-conflict) "existing branch")
          (when c
            (ok (equal "work" (rev:ref-conflict-name c)))
            (ok (null (rev:ref-conflict-expected c)))
            (ok (equal (getf k :c1) (rev:ref-conflict-actual c))))
          (ok (not (uiop:directory-exists-p (wt-dir r "wt3"))) "nothing created")
          (ok (= 2 (length (worktree-paths r)))))
        (write-octets (merge-pathnames "full/x.txt" (trepo-root r)) (utf8 "x"))
        (ok (signals (git:add-worktree s (wt-dir r "full") (getf k :c1)) 'rev:revision-error)
            "a non-empty directory")
        (ok (signals (git:add-worktree s (wt-dir r "wt4") "nope") 'rev:revision-not-found))))))

(deftest a-linked-worktree-is-its-own-target
  (with-test-repo (r)
    (let ((k (build-working-copy r)))
      (with-store (s r)
        (let* ((w (git:add-worktree s (wt-dir r "wt") (getf k :c1) :branch "agent"))
               (wcw (git:make-git-working-copy w))
               (wcm (git:make-git-working-copy s)))
          (put-file r "tracked.txt" (lines "main edit"))
          (write-octets (merge-pathnames "tracked.txt" (wt-dir r "wt")) (utf8 (lines "agent edit")))
          (ok (equal (lines "agent edit")
                     (diff:tree-file-content (file-at (rev:target-state wcw) "tracked.txt"))))
          (ok (equal (lines "main edit")
                     (diff:tree-file-content (file-at (rev:target-state wcm) "tracked.txt"))))
          (let ((index (index-hash r))
                (rv (rev:capture-revision wcw w :message "agent capture")))
            (ok (equal (rev:revision-id rv) (rev r "agent")) "the linked worktree's branch moved")
            (ok (equal (getf k :c1) (rev r "main")) "main did not")
            (ok (equal index (index-hash r)) "the main index is untouched")
            (ok (null (rev:target-drift wcw w)))
            (ok (rev:target-drift wcm s) "the main checkout still drifts"))
          (git:close-git-store w))))))

(deftest list-and-remove-worktrees
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((w1 (git:add-worktree s (wt-dir r "a") (getf k :c1)))
              (w2 (git:add-worktree s (wt-dir r "b") (getf k :c2) :branch "bee")))
          (git:close-git-store w1)
          (git:close-git-store w2)
          (let ((list (git:list-worktrees s)))
            (ok (= 3 (length list)))
            (ok (same-dir-p (trepo-dir r) (getf (first list) :path)) "main first")
            (ok (equal "main" (getf (first list) :branch)))
            (ok (equal (getf k :c3) (getf (first list) :head)))
            (let ((a (find-if (lambda (e) (same-dir-p (wt-dir r "a") (getf e :path))) list))
                  (b (find-if (lambda (e) (same-dir-p (wt-dir r "b") (getf e :path))) list)))
              (ok (and a (getf a :detached) (null (getf a :branch))))
              (ok (and a (equal (getf k :c1) (getf a :head))))
              (ok (and b (equal "bee" (getf b :branch)) (not (getf b :detached))))
              (ok (every (lambda (e) (and (null (getf e :locked)) (null (getf e :prunable))
                                          (null (getf e :bare))))
                         list))))
          (testing "locked and prunable"
            (git* r (list "worktree" "lock" "--reason" "in use" (uiop:native-namestring (wt-dir r "a"))))
            (ok (equal "in use" (getf (find-if (lambda (e) (same-dir-p (wt-dir r "a") (getf e :path)))
                                               (git:list-worktrees s))
                                      :locked)))
            (git* r (list "worktree" "unlock" (uiop:native-namestring (wt-dir r "a")))))
          (testing "remove"
            (with-checkout-unchanged (r "remove-worktree")
              (ok (eq t (git:remove-worktree s (wt-dir r "a")))))
            (ok (not (uiop:directory-exists-p (wt-dir r "a"))))
            (ok (= 2 (length (git:list-worktrees s))))
            (write-octets (merge-pathnames "dirty.txt" (wt-dir r "b")) (utf8 "dirty"))
            (ok (signals (git:remove-worktree s (wt-dir r "b")) 'git:git-command-error)
                "local changes without :force")
            (ok (uiop:directory-exists-p (wt-dir r "b")) "kept")
            (ok (eq t (git:remove-worktree s (wt-dir r "b") :force t)))
            (ok (equal (getf k :c2) (rev r "bee")) "the branch stays")
            (ok (signals (git:remove-worktree s (trepo-dir r)) 'rev:revision-error) "the main worktree")
            (ok (signals (git:remove-worktree s (wt-dir r "never")) 'rev:revision-error)
                "not a worktree")))))))

(deftest worktrees-of-a-bare-repository
  (with-test-repo (src)
    (let ((k (build-linear src)))
      (with-test-repo (b :bare t)
        (git* b (list "fetch" "-q" (uiop:native-namestring (trepo-dir src)) "main:main"))
        (with-store (s b)
          (let ((w (git:add-worktree s (wt-dir b "co") (getf k :c3))))
            (ok (not (git:git-store-bare-p w)))
            (let ((list (git:list-worktrees s)))
              (ok (getf (first list) :bare) "the bare entry first")
              (ok (= 2 (length list))))
            (git:close-git-store w)))))))

;;; ---- parser -----------------------------------------------------------------

(defparameter +wt-id-1+ "1111111111111111111111111111111111111111")
(defparameter +wt-id-2+ "2222222222222222222222222222222222222222")

(deftest parse-worktree-list-corpus
  (let ((entries (git:parse-worktree-list
                  (concatenate 'string
                               (nul-join "worktree /repo" (format nil "HEAD ~a" +wt-id-1+)
                                         "branch refs/heads/main")
                               (nul-join "")
                               (nul-join "worktree /tmp/with space" (format nil "HEAD ~a" +wt-id-2+)
                                         "detached" "locked" "prunable gitdir file points to non-existent location")
                               (nul-join "")
                               (nul-join "worktree /tmp/new" (format nil "HEAD ~a" (make-string 40 :initial-element #\0))
                                         "branch refs/heads/feature/x" "locked reason with spaces" "future-attribute value")
                               (nul-join "")
                               (nul-join "worktree /srv/bare.git" "bare")
                               (nul-join "")))))
    (ok (= 4 (length entries)))
    (ok (plist-matches-p (list :path "/repo" :head +wt-id-1+ :branch "main" :detached nil :bare nil
                               :locked nil :prunable nil)
                         (first entries)))
    (ok (plist-matches-p (list :path "/tmp/with space" :head +wt-id-2+ :branch nil :detached t
                               :locked t :prunable "gitdir file points to non-existent location")
                         (second entries)))
    (ok (plist-matches-p '(:path "/tmp/new" :head nil :branch "feature/x" :locked "reason with spaces")
                         (third entries))
        "zero id = unborn; unknown attributes ignored")
    (ok (plist-matches-p '(:path "/srv/bare.git" :bare t :head nil :branch nil) (fourth entries)))
    (ok (null (git:parse-worktree-list "")) "no output, no entries")))

(deftest-parametrize parse-worktree-list-malformed
    ((input) :ids ("no-worktree-first" "bad-head" "truncated")
     ((nul-join "HEAD 1111111111111111111111111111111111111111" ""))
     ((nul-join "worktree /r" "HEAD xyz" ""))
     ((concatenate 'string (nul-join "worktree /r") "HEAD 11")))
  (ok (signals (git:parse-worktree-list input) 'rev:revision-error)))

(deftest parse-worktree-list-live
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (git* r (list "worktree" "add" "-q" "--detach" (uiop:native-namestring (wt-dir r "live")) (getf k :c1)))
      (let ((entries (git:parse-worktree-list (git* r '("worktree" "list" "--porcelain" "-z")))))
        (ok (= 2 (length entries)))
        (ok (equal (list (getf k :c3) (getf k :c1)) (mapcar (lambda (e) (getf e :head)) entries)))
        (ok (every (lambda (e) (stringp (getf e :path))) entries) "native namestrings")))))

(deftest-parametrize parse-worktree-list-fuzz
    ((seed) :ids ("s1" "s2" "s3")
     (11) (12) (13))
  ;; Render random records with git's grammar, parse them back.
  (let ((rand (make-lcg seed)) (records '()) (expected '()))
    (dotimes (i 12)
      (let ((path (format nil "/w/~a" (fuzz-name rand)))
            (head (fuzz-id rand))
            (kind (funcall rand 3)))
        (push (apply #'nul-join
                     (append (list (format nil "worktree ~a" path) (format nil "HEAD ~a" head))
                             (case kind
                               (0 (list (format nil "branch refs/heads/b~d" i)))
                               (1 (list "detached"))
                               (t (list "detached" "locked")))
                             (list "")))
              records)
        (push (list :path path :head head
                    :branch (and (= kind 0) (format nil "b~d" i))
                    :detached (/= kind 0)
                    :locked (and (= kind 2) t))
              expected)))
    (let ((parsed (git:parse-worktree-list (apply #'concatenate 'string (reverse records)))))
      (ok (= 12 (length parsed)))
      (ok (every #'plist-matches-p (reverse expected) parsed)))))
