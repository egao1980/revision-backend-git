(in-package #:revision-backend-git/tests)

;;; V1 PROJECT-MERGE (`git merge-tree --write-tree`) and committing merges.
;;; Expected trees and conflicted paths come from running real merge-tree.

(defun change-shape (change)
  (and change (list (diff:change-kind change) (diff:change-path change))))

(defun conflict-at (conflicts path)
  (find-if (lambda (c)
             (equal (diff:change-path (or (diff:conflict-ours c) (diff:conflict-theirs c)))
                    (list path)))
           conflicts))

(deftest project-merge-clean
  (with-test-repo (r)
    (let ((k (build-diverged r)))
      (with-store (s r)
        (multiple-value-bind (p conflicts)
            (with-checkout-unchanged (r "project-merge")
              (rev:project-merge s (getf k :ours) (getf k :theirs)))
          (multiple-value-bind (tree paths) (real-merge-tree r (getf k :ours) (getf k :theirs))
            (ok (null paths) "fixture: git agrees it is clean")
            (ok (git:git-projection-p p))
            (ok (null conflicts))
            (ok (null (rev:projection-conflicts p)))
            (ok (eq :exact (rev:projection-fidelity p)))
            (ok (not (rev:projection-writable-p p)))
            (ok (null (git:git-projection-worktree p)) "virtual")
            (ok (equal (list (getf k :ours) (getf k :theirs)) (rev:projection-parents p)))
            (ok (equal tree (git:git-projection-tree p)) "merge-tree's tree")
            (ok (equal tree (git:merge-projection-marker-tree p)) "no markers: same tree")
            (ok (equal (lines "ours" "2" "3" "4" "5" "6" "7" "theirs")
                       (pathlib:read-text (pathlib:join (rev:projection-view p) "shared.txt")))
                "both edits")
            (ok (equal '("keep.txt" "md.txt" "ours.txt" "shared.txt" "theirs.txt")
                       (mapcar #'car (tree-files (rev:projection-state p)))))))))))

(deftest project-merge-designators
  (with-test-repo (r)
    (let ((k (build-diverged r)))
      (with-store (s r)
        (let ((p (rev:project-merge s (rev:rev-ref "main") "topic")))
          (ok (equal (list (getf k :ours) (getf k :theirs)) (rev:projection-parents p))
              "parents are ids"))
        (ok (signals (rev:project-merge s "main" "nope") 'rev:revision-not-found))))))

(deftest project-merge-conflicts-as-data
  (with-test-repo (r)
    (let ((k (build-diverged r :conflict t)))
      (with-store (s r)
        (multiple-value-bind (p conflicts)
            (with-checkout-unchanged (r "conflicting project-merge")
              (rev:project-merge s (getf k :ours) (getf k :theirs)))
          (multiple-value-bind (tree paths code) (real-merge-tree r (getf k :ours) (getf k :theirs))
            (ok (= 1 code) "fixture: git reports conflicts")
            (ok (equal '("md.txt" "shared.txt") (sort (copy-list paths) #'string<)))
            (ok (every (lambda (c) (typep c 'diff:diff-conflict)) conflicts))
            (ok (equal '("md.txt" "shared.txt") (conflict-paths conflicts))
                "one conflict per conflicted path")
            (ok (equal (conflict-paths conflicts) (conflict-paths (rev:projection-conflicts p))))
            (ok (equal tree (git:merge-projection-marker-tree p)) "merge-tree's tree, markers in it")
            (ok (search "<<<<<<<" (blob-text r tree "shared.txt")))
            (let ((state (rev:projection-state p)))
              (ok (equal +shared-base+ (diff:tree-file-content (file-at state "shared.txt")))
                  "a conflicted path keeps the base value")
              (ok (equal (lines "md") (diff:tree-file-content (file-at state "md.txt")))
                  "modify/delete: base value")
              (ok (file-at state "ours.txt") "clean parts merged")
              (ok (file-at state "theirs.txt")))
            (ok (not (equal tree (git:git-projection-tree p))) "projection tree ≠ marker tree")
            (ok (equal +shared-base+
                       (pathlib:read-text (pathlib:join (rev:projection-view p) "shared.txt")))
                "the view shows the projection state")
            (let ((shared (conflict-at conflicts "shared.txt"))
                  (md (conflict-at conflicts "md.txt")))
              (ok (equal '(:modify ("shared.txt")) (change-shape (diff:conflict-ours shared))))
              (ok (equal '(:modify ("shared.txt")) (change-shape (diff:conflict-theirs shared))))
              (ok (member "tree:/shared.txt" (diff:conflict-footprint shared) :test #'string=))
              (ok (equal '(:modify ("md.txt")) (change-shape (diff:conflict-ours md))))
              (ok (equal '(:remove ("md.txt")) (change-shape (diff:conflict-theirs md)))
                  "theirs deleted it"))))))))

(deftest project-merge-unrelated-and-criss-cross
  (with-test-repo (r)
    (let ((k (build-criss-cross r)))
      (with-store (s r)
        (testing "unrelated histories: the base is the empty tree"
          (let ((p (rev:project-merge s (getf k :d) (getf k :u))))
            (ok (null (rev:projection-conflicts p)))
            (ok (equal (real-merge-tree r (getf k :d) (getf k :u)) (git:git-projection-tree p)))
            (ok (equal '("a.txt" "b.txt" "c.txt" "u.txt")
                       (mapcar #'car (tree-files (rev:projection-state p)))))))
        (testing "criss-cross: git's virtual merge base"
          (let ((p (rev:project-merge s (getf k :d) (getf k :e))))
            (ok (equal (real-merge-tree r (getf k :d) (getf k :e)) (git:git-projection-tree p)))
            (ok (equal (list (getf k :d) (getf k :e)) (rev:projection-parents p)))))
        (testing "already merged: the merge is the ancestor's descendant"
          (let ((p (rev:project-merge s (getf k :d) (getf k :b))))
            (ok (equal (tree-of r (getf k :d)) (git:git-projection-tree p)))))))))

(deftest-parametrize law-4-merge-is-symmetric
    ((conflict) :ids ("clean" "conflicting")
     (nil) (t))
  (with-test-repo (r)
    (let ((k (build-diverged r :conflict conflict)))
      (with-store (s r)
        (let ((ab (rev:project-merge s (getf k :ours) (getf k :theirs)))
              (ba (rev:project-merge s (getf k :theirs) (getf k :ours))))
          (ok (equal (conflict-paths (rev:projection-conflicts ab))
                     (conflict-paths (rev:projection-conflicts ba))))
          (ok (state= (rev:projection-state ab) (rev:projection-state ba))
              "same projected state either way")
          (ok (equal (list (getf k :theirs) (getf k :ours)) (rev:projection-parents ba)))
          (loop for c in (rev:projection-conflicts ab)
                for path = (first (diff:change-path (or (diff:conflict-ours c) (diff:conflict-theirs c))))
                for mirror = (conflict-at (rev:projection-conflicts ba) path)
                do (ok (equal (change-shape (diff:conflict-ours c))
                              (change-shape (diff:conflict-theirs mirror)))
                       (format nil "~a: ours of a/b = theirs of b/a" path))))))))

(deftest commit-merge-projection-clean
  (with-test-repo (r)
    (let ((k (build-diverged r)))
      (with-store (s r)
        (let* ((p (rev:project-merge s (getf k :ours) (getf k :theirs)))
               (rv (with-checkout-unchanged (r "commit-projection of a merge")
                     (rev:commit-projection s p :message "merge topic" :ref "merged"))))
          (ok (equal (list (getf k :ours) (getf k :theirs)) (rev:revision-parent-ids rv))
              "a two-parent merge commit")
          (ok (equal (git:git-projection-tree p) (rev:revision-content rv)))
          (ok (equal (rev:revision-id rv) (rev r "merged")))
          (ok (equal (format nil "~a ~a" (getf k :ours) (getf k :theirs))
                     (git r "log" "-1" "--format=%P" (rev:revision-id rv)))
              "git sees the parents")
          (ok (rev:ancestor-p s (getf k :theirs) rv)))))))

(deftest commit-merge-projection-conflict-restarts
  (with-test-repo (r)
    (let ((k (build-diverged r :conflict t)))
      (with-store (s r)
        (let ((p (rev:project-merge s (getf k :ours) (getf k :theirs))))
          (testing "MERGE-CONFLICT and its restarts"
            (multiple-value-bind (names c)
                (restart-names-in 'rev:merge-conflict (lambda () (rev:commit-projection s p)))
              (ok (typep c 'rev:merge-conflict))
              (when c
                (ok (eq p (rev:merge-conflict-projection c)))
                (ok (equal '("md.txt" "shared.txt") (conflict-paths (rev:merge-conflict-conflicts c)))))
              (dolist (n '(rev:take-ours rev:take-theirs rev:use-merged abort))
                (ok (member n names) (format nil "restart ~a" n)))))
          (flet ((commit-with (restart)
                   (handler-bind ((rev:merge-conflict
                                    (lambda (c) (invoke-restart (find-restart restart c)))))
                     (with-checkout-unchanged (r (format nil "commit with ~a" restart))
                       (rev:commit-projection s p :message (string restart))))))
            (let ((rv (commit-with 'rev:take-ours)))
              (ok (equal (list (getf k :ours) (getf k :theirs)) (rev:revision-parent-ids rv)))
              (ok (equal (lines "ours" "2" "3" "4" "5" "6" "7" "8")
                         (blob-text r (rev:revision-id rv) "shared.txt")))
              (ok (equal (lines "md" "edited") (blob-text r (rev:revision-id rv) "md.txt")))
              (ok (member "theirs.txt" (tree-paths r (rev:revision-content rv)) :test #'string=)
                  "clean parts kept"))
            (let ((rv (commit-with 'rev:take-theirs)))
              (ok (equal (lines "theirs" "2" "3" "4" "5" "6" "7" "8")
                         (blob-text r (rev:revision-id rv) "shared.txt")))
              (ok (not (member "md.txt" (tree-paths r (rev:revision-content rv)) :test #'string=))
                  "their delete"))
            (let ((rv (commit-with 'rev:use-merged)))
              (ok (equal (git:git-projection-tree p) (rev:revision-content rv)) "base values")
              (ok (equal +shared-base+ (blob-text r (rev:revision-id rv) "shared.txt"))))
            (let ((main (rev r "main")))
              (ok (null (handler-bind ((rev:merge-conflict
                                         (lambda (c) (invoke-restart (find-restart 'abort c)))))
                          (rev:commit-projection s p :ref "main")))
                  "abort → NIL")
              (ok (equal main (rev r "main")) "nothing moved"))))))))

(deftest resolve-a-merge-by-hand
  ;; Materialize the merge result, edit the conflicted file, commit: the
  ;; merge's parents carry over; conflicts do not (the caller resolved them).
  (with-test-repo (r)
    (let ((k (build-diverged r :conflict t)))
      (with-store (s r)
        (let* ((git:*projection-directory*
                 (ensure-directories-exist (merge-pathnames "projections/" (trepo-root r))))
               (m (rev:project-merge s (getf k :ours) (getf k :theirs)))
               (w (rev:project-state s m :writable t))
               (wt (git:git-projection-worktree w)))
          (ok (equal (rev:projection-parents m) (rev:projection-parents w)))
          (ok (null (rev:projection-conflicts w)))
          (ok (state= (rev:projection-state m) (rev:projection-state w)))
          (write-octets (merge-pathnames "shared.txt" wt)
                        (utf8 (lines "resolved" "2" "3" "4" "5" "6" "7" "8")))
          (let ((rv (with-checkout-unchanged (r "commit a hand-resolved merge")
                      (rev:commit-projection s w :message "resolved" :ref "resolved"))))
            (ok (equal (list (getf k :ours) (getf k :theirs)) (rev:revision-parent-ids rv)))
            (ok (equal (lines "resolved" "2" "3" "4" "5" "6" "7" "8")
                       (blob-text r (rev:revision-id rv) "shared.txt"))))
          (rev:discard-projection w))))))
