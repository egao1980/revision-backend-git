(in-package #:revision-backend-git/tests)

;;; COMMIT-REVISION: every content form, parents, refs, identity, dates,
;;; messages, atomicity; checked with real git.

(defun sample-tree ()
  (diff:make-tree "a.txt" (diff:make-tree-file (lines "x"))
                  "bin" (diff:make-tree "b.bin" (diff:make-tree-file +bin-v1+))
                  "run" (diff:make-tree-file (lines "#!/bin/sh") :mode #o100755)
                  "crlf.txt" (diff:make-tree-file +crlf-v1+)))

(defmacro at-time ((seconds) &body body)
  `(dt:with-fixed-clock ((instant ,seconds)) ,@body))

(deftest commit-a-tree-value
  (with-test-repo (r)
    (with-store (s r)
      (let* ((rv (at-time ((+ +t0+ 7)) (rev:commit-revision s (sample-tree) :ref "main" :message "root")))
             (id (rev:revision-id rv)))
        (ok (equal id (rev r "refs/heads/main")) "main created")
        (ok (null (rev:revision-parent-ids rv)) "a root")
        (ok (equal (lines "a.txt" "bin/b.bin" "crlf.txt" "run")
                   (git* r (list "ls-tree" "-r" "--name-only" id))))
        (ok (equal "100755" (subseq (git r "ls-tree" id "run") 0 6)) "mode kept")
        (ok (equalp +bin-v1+ (git* r (list "cat-file" "blob" (format nil "~a:bin/b.bin" id))
                                   :output :octets))
            "binary blob exact")
        (ok (equalp (utf8 +crlf-v1+) (git* r (list "cat-file" "blob" (format nil "~a:crlf.txt" id))
                                           :output :octets))
            "CRLF kept")
        (ok (state= (sample-tree) (rev:revision-state s id)) "state round-trips")
        (ok (equal (lines "root") (git* r (list "log" "-1" "--format=%B" id))) "message + newline")
        (ok (equal "root" (rev:revision-message rv)))
        (ok (equal (format nil "~d ~d" (+ +t0+ 7) (+ +t0+ 7))
                   (git r "log" "-1" "--format=%ct %at" id))
            "committer and author date from DT:NOW")))))

(deftest commit-parents-and-refs
  (with-test-repo (r)
    (with-store (s r)
      (let* ((a (at-time (+t0+) (rev:commit-revision s (sample-tree) :ref "main" :message "a")))
             (tree2 (diff:make-tree "a.txt" (diff:make-tree-file (lines "y"))))
             (b (at-time ((+ +t0+ 10)) (rev:commit-revision s tree2 :ref "main" :message "b"))))
        (ok (equal (list (rev:revision-id a)) (rev:revision-parent-ids b)) "parent defaults to the ref tip")
        (ok (equal (rev:revision-id b) (rev r "main")))
        (let ((side (at-time ((+ +t0+ 20))
                      (rev:commit-revision s tree2 :parents (list a) :ref "side" :message "side"))))
          (ok (equal (rev:revision-id side) (rev r "side")))
          (let ((m (at-time ((+ +t0+ 30))
                     (rev:commit-revision s tree2 :parents (list (rev:rev-ref "main") side)
                                          :ref "main" :message "merge"))))
            (ok (equal (list (rev:revision-id b) (rev:revision-id side)) (rev:revision-parent-ids m)))
            (ok (equal (git r "log" "-1" "--format=%P" (rev:revision-id m))
                       (format nil "~a ~a" (rev:revision-id b) (rev:revision-id side))))))
        (let ((root (rev:commit-revision s tree2 :parents nil :ref "main" :message "new root")))
          (ok (null (rev:revision-parent-ids root)) ":parents nil = a root")
          (ok (equal (rev:revision-id root) (rev r "main"))))
        (let ((loose (rev:commit-revision s tree2 :parents (list a) :message "no ref")))
          (ok (equal "commit" (git r "cat-file" "-t" (rev:revision-id loose))) "commit without a ref")
          (ok (equal (rev:revision-id root) (rev r "main")) "no ref moved"))))))

(deftest commit-tree-ids-and-index
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let ((t1 (git r "rev-parse" (format nil "~a^{tree}" (getf k :c1)))))
          (ok (equal t1 (rev:revision-content (rev:commit-revision s t1 :message "by tree id")))
              "a full tree id")
          (ok (equal (git r "rev-parse" "HEAD^{tree}")
                     (rev:revision-content (rev:commit-revision s "HEAD^{tree}" :message "revspec")))
              "a revspec naming a tree"))
        (put-file r "staged.txt" (lines "staged"))
        (git* r '("add" "staged.txt"))
        (put-file r "a.txt" (lines "unstaged edit"))
        (let ((before (index-digest r))
              (rv (rev:commit-revision s :index :parents (list (rev:rev-ref "main")) :message "index")))
          (ok (equal (git r "write-tree") (rev:revision-content rv)) "the index tree")
          (ok (equalp before (index-digest r)) "index file untouched")
          (ok (equal (lines "one" "two")
                     (git* r (list "cat-file" "blob" (format nil "~a:a.txt" (rev:revision-id rv)))))
              "unstaged edits are not in it"))))))

(deftest commit-a-diff-and-a-payload
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (let* ((old (rev:revision-state s (getf k :c3)))
               (new (diff:make-tree "a.txt" (diff:make-tree-file (lines "one" "two" "three"))
                                    "dir" (diff:make-tree "c.txt" (diff:make-tree-file (lines "see")))
                                    "z.txt" (diff:make-tree-file (lines "zed"))))
               (delta (diff:compute-diff (tree-engine) old new))
               (rv (rev:commit-revision s delta :ref "main" :message "delta")))
          (ok (equal (list (getf k :c3)) (rev:revision-parent-ids rv)))
          (ok (state= new (rev:revision-state s rv)) "delta applied to the first parent's state"))
        (let* ((tree (diff:make-tree "only.txt" (diff:make-tree-file (lines "payload"))))
               (rv (rev:commit-revision s (rev:make-payload :state tree) :message "payload")))
          (ok (state= tree (rev:revision-state s rv))))
        (let* ((tree (diff:make-tree "root.txt" (diff:make-tree-file (lines "r"))))
               (rv (rev:commit-revision s (diff:compute-diff (tree-engine) (diff:make-tree) tree)
                                        :parents nil :message "root delta")))
          (ok (state= tree (rev:revision-state s rv)) "a root's delta is against the empty tree"))))))

(deftest commit-identity-dates-and-determinism
  (with-test-repo (r)
    (with-store (s r)
      (let ((a (at-time ((+ +t0+ 50))
                 (rev:commit-revision s (sample-tree) :message "same"
                                      :valid-at (instant (- +t0+ 1000))
                                      :provenance (list :author-name "Ada Lovelace"
                                                        :author-email "ada@example.invalid")))))
        (ok (equal (format nil "Ada Lovelace|ada@example.invalid|Test User|test@example.invalid|~d|~d"
                           (- +t0+ 1000) (+ +t0+ 50))
                   (git r "log" "-1" "--format=%an|%ae|%cn|%ce|%at|%ct" (rev:revision-id a))))
        (ok (= (- +t0+ 1000) (unix (rev:revision-valid-at a))))
        (ok (= (+ +t0+ 50) (unix (rev:revision-recorded-at a))))
        (ok (plist-matches-p '(:author-name "Ada Lovelace" :committer-name "Test User")
                             (rev:revision-provenance a)))
        (let ((b (at-time ((+ +t0+ 50))
                   (rev:commit-revision s (sample-tree) :message "same"
                                        :valid-at (instant (- +t0+ 1000))
                                        :provenance (list :author-name "Ada Lovelace"
                                                          :author-email "ada@example.invalid")))))
          (ok (equal (rev:revision-id a) (rev:revision-id b))
              "same content, parents, identity and clock → same id"))))))

(deftest commit-refusals-are-atomic
  (with-test-repo (r)
    (let ((k (build-linear r)))
      (with-store (s r)
        (ok (signals (rev:commit-revision s (sample-tree) :id "abcd1234") 'rev:revision-error)
            "git chooses ids")
        (ok (signals (rev:commit-revision s 42) 'rev:revision-error) "unknown content")
        (ok (signals (rev:commit-revision s "no-such-tree^{tree}") 'rev:revision-error))
        (ok (signals (rev:commit-revision s (sample-tree) :ref "new-branch"
                                          :parents '("deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"))
                     'rev:revision-not-found))
        (ok (null (ref-id r "refs/heads/new-branch")) "no ref created")
        (let ((c (capture-condition (rev:ref-conflict)
                   (rev:commit-revision s (sample-tree) :ref "main" :expected (getf k :c1)))))
          (ok (typep c 'rev:ref-conflict))
          (when c (ok (equal (getf k :c3) (rev:ref-conflict-actual c)))))
        (ok (equal (getf k :c3) (rev r "main")) "main unchanged")))))

(deftest commit-in-a-bare-repository
  (with-test-repo (r :bare t)
    (with-store (s r)
      (let ((rv (rev:commit-revision s (sample-tree) :ref "main" :message "bare")))
        (ok (equal (rev:revision-id rv) (rev r "main")))
        (ok (state= (sample-tree) (rev:revision-state s "main")))))))
